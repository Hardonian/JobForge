// Prisma schema for JobForge
// Multi-tenant agent router schema synchronized with Supabase SQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobforgeTenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  tier      String   @default("standard")
  isActive  Boolean  @default(true) @map("is_active")
  isPaused  Boolean  @default(false) @map("is_paused")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobs      JobforgeJob[]
  apiKeys   JobforgeApiKey[]
  quota     JobforgeQuota?

  @@map("jobforge_tenants")
}

model JobforgeJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  priority       Int       @default(0)
  timeoutMs      Int       @default(300000) @map("timeout_ms")
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  heartbeatAt    DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  idempotencyKey String?   @map("idempotency_key")
  createdBy      String?   @map("created_by")
  error          Json?
  resultId       String?   @map("result_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         JobforgeTenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  results        JobforgeJobResult[]
  attemptsList   JobforgeJobAttempt[]

  @@unique([tenantId, type, idempotencyKey], name: "jobforge_jobs_idempotency_unique")
  @@index([tenantId, status, priority, runAt], name: "idx_jobforge_jobs_claim")
  @@index([status, heartbeatAt], name: "idx_jobforge_jobs_stuck")
  @@map("jobforge_jobs")
}

model JobforgeJobResult {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String      @map("job_id") @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  result      Json        @default("{}")
  artifactRef String?     @map("artifact_ref")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  job         JobforgeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], name: "idx_jobforge_job_results_job_id")
  @@index([tenantId, createdAt], name: "idx_jobforge_job_results_tenant")
  @@map("jobforge_job_results")
}

model JobforgeJobAttempt {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String      @map("job_id") @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  attemptNo  Int         @map("attempt_no")
  startedAt  DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(6)
  error      Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  job        JobforgeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attemptNo], name: "idx_jobforge_job_attempts_job_id")
  @@index([tenantId, createdAt], name: "idx_jobforge_job_attempts_tenant")
  @@map("jobforge_job_attempts")
}

model JobforgeApiKey {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  name       String
  keyPrefix  String         @map("key_prefix")
  keyHash    String         @unique @map("key_hash")
  scopes     Json           @default("[\"jobs:read\", \"jobs:write\"]")
  expiresAt  DateTime?      @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime?      @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     JobforgeTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([keyHash], name: "idx_jobforge_api_keys_hash")
  @@index([tenantId], name: "idx_jobforge_api_keys_tenant")
  @@map("jobforge_api_keys")
}

model JobforgeQuota {
  tenantId           String         @id @map("tenant_id") @db.Uuid
  maxConcurrentJobs  Int            @default(10) @map("max_concurrent_jobs")
  maxMonthlyJobs     Int            @default(50000) @map("max_monthly_jobs")
  maxPayloadBytes    Int            @default(5242880) @map("max_payload_bytes")
  burstAllowance     Int            @default(5) @map("burst_allowance")
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             JobforgeTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("jobforge_quotas")
}
